{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vr-diagnostic",
      "displayName": "Skyrim VR Read-only Diagnostic",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vr-diagnostic",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{CMS_VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMS_ENABLE_READONLY_VRMELEE_PROBE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vr-diagnostic",
      "configurePreset": "vr-diagnostic"
    }
  ]
}
